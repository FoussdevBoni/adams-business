NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# URI Atlas avec le nom de base adams_business. Renseigner uniquement dans backend/.env.
MONGODB_URI=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# Délai maximal du ping du contrôle de santé (ms)
MONGODB_PING_TIMEOUT_MS=2000

# Base Atlas de test isolée, utilisée uniquement par les tests d'intégration.
# Utiliser une URI Atlas dédiée à adams_business_test pour les tests d’intégration.
# Exemple : mongodb+srv://<utilisateur>:<mot-de-passe>@<cluster>/adams_business_test?retryWrites=true&w=majority
MONGODB_TEST_URI=
RESEND_API_KEY=
RESEND_FROM="Adam’s Business <no-reply@example.com>"
# Intervalle de traitement de la file d'emails (ms)
EMAIL_WORKER_INTERVAL_MS=15000

# Origines autorisées (liste blanche CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
JSON_BODY_LIMIT=1mb

# URL publique du frontend (liens des emails, plan du site) ; https obligatoire en production
APP_PUBLIC_URL=http://localhost:5173
# Nombre de proxys de confiance devant l'API (0 en local)
TRUST_PROXY=0
# Cookie de session : lax | strict | none (none exige COOKIE_SECURE=true)
SESSION_COOKIE_SAMESITE=lax
# Par défaut true en production (obligatoire), false sinon
COOKIE_SECURE=
# Rétention du journal d'audit, en jours
AUDIT_LOG_RETENTION_DAYS=365



# Cloudinary (médias) : sans ces trois valeurs, le téléversement répond 503
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Dossier Cloudinary des médias du site
CLOUDINARY_FOLDER=adams-business
# Développement uniquement. Laisser vide pour utiliser Cloudinary.
MEDIA_LOCAL_DIR=.shop-media
# Taille maximale d'une image, en octets (5 Mo)
MEDIA_MAX_BYTES=5242880